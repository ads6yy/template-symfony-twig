{% extends "base.html.twig" %}

{% block title %}{{ 'auth.resend_verification.title'|trans }} - {{ parent() }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="card-title text-center mb-4">✉️ {{ 'auth.resend_verification.title'|trans }}</h2>

                <p class="text-muted text-center">{{ 'auth.resend_verification.help'|trans }}</p>

                <form method="post" action="{{ path('app_auth_resend_verification') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('resend_verification') }}">

                    <div class="mb-3">
                        <label for="email" class="form-label">{{ 'form.email.label'|trans }}</label>
                        <input type="email" id="email" name="email" class="form-control" required
                               value="{{ app.user ? app.user.userIdentifier : '' }}">
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        {{ 'auth.resend_verification.submit'|trans }}
                    </button>
                </form>

                <hr>

                <p class="text-center">
                    <a href="{{ path('app_auth_logout') }}">{{ 'nav.logout'|trans }}</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
