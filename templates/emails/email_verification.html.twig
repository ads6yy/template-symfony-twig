<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #007bff;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }
        .content {
            background-color: #f8f9fa;
            padding: 30px;
            border-radius: 0 0 5px 5px;
        }
        .cta-wrapper {
            text-align: center;
        }
        .cta-button {
            display: inline-block;
            padding: 12px 24px;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 20px 0;
        }
        .fallback-link {
            word-break: break-all;
            font-size: 12px;
            color: #6c757d;
        }
        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ 'email.email_verification.title'|trans({}, 'messages', locale) }}</h1>
    </div>
    <div class="content">
        <p>{{ 'email.email_verification.greeting'|trans({'%name%': user.firstName ?: user.email}, 'messages', locale) }}</p>

        <p>{{ 'email.email_verification.message'|trans({}, 'messages', locale) }}</p>

        <div class="cta-wrapper">
            <a href="{{ signedUrl }}" class="cta-button">{{ 'email.email_verification.button'|trans({}, 'messages', locale) }}</a>
        </div>

        <p>{{ 'email.email_verification.expiration'|trans({'%duration%': expiresText}, 'messages', locale) }}</p>

        <p class="fallback-link">{{ signedUrl }}</p>

        <p>{{ 'email.email_verification.footer'|trans({}, 'messages', locale) }}</p>
    </div>
    <div class="footer">
        <p>{{ 'footer.copyright'|trans({}, 'messages', locale) }}</p>
    </div>
</body>
</html>
